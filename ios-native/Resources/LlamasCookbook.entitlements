<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      App Group shared container, paired with the same entitlement on
      ShareExtension/LlamasCookbookShareExtension.entitlements. Lets
      the share extension and the main app exchange `.llamarecipe`
      files via Sources/Shared/SharedContainer.swift's `share-inbox/`
      directory. See Share-Extension-Plan.md §3 + §7.

      Identifier MUST match SharedContainer.appGroupID and the App
      Group registered in Apple Developer Portal — three places, one
      string, no drift.
    -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.llamascookbook.app</string>
    </array>
    <!--
      Sign in with Apple — identity primitive for cloud recipe delivery.
      See Implementing-User-Sign-In.md §3 + §10. Entitlement must be
      enabled on the App ID in Apple Developer Portal AND the
      provisioning profile regenerated after enabling it; the
      capability is baked into the profile at issue time, so a stale
      profile silently strips the entitlement at sign and the runtime
      `ASAuthorizationController` call fails with error 1000
      ("not handled").
    -->
    <key>com.apple.developer.applesignin</key>
    <array>
        <string>Default</string>
    </array>
    <!--
      iCloud / CloudKit — recipe-share permalink hosting. Sender
      uploads the share envelope (with photos as CKAsset) to the
      public DB, gets back a random 6-char record ID, mints
      `llamascookbook://share/<id>` and ships that to the recipient.
      Recipient fetches by record ID; no Llamas Cookbook account
      required on the receive side, only a system iCloud account
      (which iPhone users effectively always have).

      Same portal+profile dance as Sign in with Apple above:
      capability enabled on the App ID in Apple Developer Portal,
      container `iCloud.com.llamascookbook.app` created, and the
      main app's provisioning profile regenerated after the
      capability is added — the entitlement is baked into the
      profile at issue time, so a stale profile fails sign with
      "Provisioning profile doesn't include the
      com.apple.developer.icloud-services entitlement." See
      Implementing-User-Sign-In.md §10.

      Container identifier MUST match `CloudKitService.containerID`
      in Sources/Lib/CloudKitService.swift — three places, one
      string, no drift (here, the Swift constant, and the App ID
      Capabilities config in the portal).
    -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.llamascookbook.app</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
</dict>
</plist>
