<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      App Group shared container, paired with the same entitlement on
      ShareExtension/LlamasCookbookShareExtension.entitlements. Lets
      the share extension and the main app exchange `.llamarecipe`
      files via Sources/Shared/SharedContainer.swift's `share-inbox/`
      directory. See Share-Extension-Plan.md §3 + §7.

      Identifier MUST match SharedContainer.appGroupID and the App
      Group registered in Apple Developer Portal — three places, one
      string, no drift.
    -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.llamascookbook.app</string>
    </array>
</dict>
</plist>
