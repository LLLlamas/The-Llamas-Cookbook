# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# macOS
.DS_Store

# iOS signing material — these contain private keys and must NEVER be committed.
*.p8
*.p12
*.mobileprovision
*.key
*.jks
*.pem
credentials.json
credentials/

# Xcode build output (the real Xcode project is generated by XcodeGen; see
# ios-native/.gitignore for the ios-native/ specifics).
build/
DerivedData/
.build/
xcuserdata/
*.xcuserstate
Packages/
Package.resolved

# Local-only screenshots / scratch evidence — used to share visual context with
# Claude Code; never meant to be committed.
testing/

# Environment overrides
.env
.env*.local
# Cloudflare Wrangler local dev state (secrets in .dev.vars, build cache in .wrangler/)
.dev.vars
.wrangler/

# Local planning docs, design handoffs, prior audits — kept on disk for
# reference but not shipped or shared in the repo. README.md remains the
# GitHub front door; local agent notes belong in CLAUDE.md or md_files/.
md_files/
/CLAUDE.md
/claude.md

# Editor / OS scratch
.idea/
.vscode/
*.swp
*~

# Logs
*.log

# Claude Code agent definitions and agent memory — local tooling, not shared.
# Agents live at user scope (~/.claude/agents/) so the project doesn't need a copy.
.claude/settings.local.json
.claude/agents/
.claude/agent-memory/

# Leftover Expo / React Native artifacts on disk (the RN source itself lives
# in outdated/rn-expo/ and is tracked). These directories can be deleted once
# Lorenzo no longer needs to run `npm install` in the archived folder.
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
*.tsbuildinfo
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*

# CloudKit cktool working exports (regenerated per run)
cloudkit/current-*.ckdb
